var a = 0;

for a < 5 {
    a = a + 1;
}

print "a: " + a;

var b = 0;

for var i = 0; i < 5; i = i + 1 {
    b = b + 1;
}

print "b: " + b;

var c = 0;
var i = 0;

for ; i < 5; i = i + 1 {
    c = c + 1;
}

print "c: " + c;

var d = 0;
var i = 0;

for ; i < 5; {
    d = d + 1;
    i = i + 1;
}

print "d: " + d;