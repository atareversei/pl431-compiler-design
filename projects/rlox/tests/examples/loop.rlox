var a = 0;

for a < 5 {
    a = a + 1;
}

print "a: " + a;

var b = 0;

for var i = 0; i < 5; i = i + 1 {
    b = b + 1;
}

print "b: " + b;

var c = 0;
var i = 0;

for ; i < 5; i = i + 1 {
    c = c + 1;
}

print "c: " + c;

var d = 0;
var i = 0;

for ; i < 5; {
    d = d + 1;
    i = i + 1;
}

print "d: " + d;

var e = 0;
for {
    e = e + 1;
    if e == 5 {
        break;
    }
}

print "e: " + e;

var f = 0;
var g = 0;
for {
    f = f + 1;
    if f < 5 {
        continue;
    } else {
        break;
    }
    g = g + 1;
}

print "f: " + f;
print "g: " + g;

var x = 0;
var y = 0;

for var i = 0; i < 5; i = i + 1 {
    for var j = 0; j < 5; j = j + 1 {
        if x == 10 {
            break;
        }
        x = x + 1;
    }
    y = y + 1;
}

print "x: " + x;
print "y: " + y;